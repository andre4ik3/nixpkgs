diff --git a/kernel/module/hashes.c b/kernel/module/hashes.c
index 3d3cf03..689d166 100644
--- a/kernel/module/hashes.c
+++ b/kernel/module/hashes.c
@@ -17,11 +17,47 @@
 
 #include "internal.h"
 
+struct parsed_module_hashes_root {
+	u32 levels;
+	struct module_hash hash;
+};
+
+static int module_hashes_parse_root(struct parsed_module_hashes_root *root)
+{
+	if (memcmp(module_hashes_root, MODULE_HASHES_ROOT_MAGIC,
+		   MODULE_HASHES_ROOT_MAGIC_SIZE) ||
+	    module_hashes_root[MODULE_HASHES_ROOT_VERSION_OFFSET] !=
+		   MODULE_HASHES_ROOT_VERSION ||
+	    module_hashes_root[MODULE_HASHES_ROOT_HASH_OFFSET] !=
+		   MODULE_HASHES_ROOT_HASH_SHA256 ||
+	    module_hashes_root[MODULE_HASHES_ROOT_TREE_OFFSET] !=
+		   MODULE_HASHES_ROOT_TREE_BINARY ||
+	    module_hashes_root[MODULE_HASHES_ROOT_RESERVED_OFFSET])
+		return -ENOPKG;
+
+	root->levels = get_unaligned_be32(module_hashes_root +
+					  MODULE_HASHES_ROOT_LEVELS_OFFSET);
+	if (!root->levels || root->levels > MODULE_HASHES_MAX_LEVELS)
+		return -ENOPKG;
+
+	memcpy(&root->hash,
+	       module_hashes_root + MODULE_HASHES_ROOT_HASH_DATA_OFFSET,
+	       sizeof(root->hash));
+
+	return 0;
+}
+
 static __init __maybe_unused int module_hashes_init(void)
 {
+	struct parsed_module_hashes_root root;
+
+	if (module_hashes_parse_root(&root)) {
+		pr_debug("root: not finalized\n");
+		return 0;
+	}
+
 	pr_debug("root: levels=%u hash=%*phN\n",
-		 module_hashes_root.levels,
-		 (int)sizeof(module_hashes_root.hash), &module_hashes_root.hash);
+		 root.levels, (int)sizeof(root.hash), &root.hash);
 
 	return 0;
 }
@@ -58,27 +94,34 @@ static void hash_data(const u8 *d, size_t len, unsigned int pos, struct module_h
 	sha256_final(&ctx, out->h);
 }
 
-static bool module_hashes_verify_proof(u32 pos, const struct module_hash *hash_sigs,
+static bool module_hashes_verify_proof(const struct parsed_module_hashes_root *root,
+				       u32 pos, const struct module_hash *hash_sigs,
 				       struct module_hash *cur)
 {
-	for (unsigned int i = 0; i < module_hashes_root.levels; i++, pos >>= 1) {
+	for (unsigned int i = 0; i < root->levels; i++, pos >>= 1) {
 		if ((pos & 1) == 0)
 			hash_entry(cur, &hash_sigs[i], cur);
 		else
 			hash_entry(&hash_sigs[i], cur, cur);
 	}
 
-	return !memcmp(cur, &module_hashes_root.hash, sizeof(module_hashes_root.hash));
+	return !memcmp(cur, &root->hash, sizeof(root->hash));
 }
 
 int module_hash_check(const void *mod, size_t mod_len, const void *sig, size_t sig_len)
 {
 	const struct module_hashes_proof *proof;
+	struct parsed_module_hashes_root root;
 	struct module_hash modhash;
 	size_t proof_size;
+	int ret;
 	u32 pos;
 
-	proof_size = struct_size(proof, hash_sigs, module_hashes_root.levels);
+	ret = module_hashes_parse_root(&root);
+	if (ret)
+		return ret;
+
+	proof_size = struct_size(proof, hash_sigs, root.levels);
 
 	if (sig_len != proof_size)
 		return -ENOPKG;
@@ -88,7 +131,7 @@ int module_hash_check(const void *mod, size_t mod_len, const void *sig, size_t s
 
 	hash_data(mod, mod_len, pos, &modhash);
 
-	if (!module_hashes_verify_proof(pos, proof->hash_sigs, &modhash))
+	if (!module_hashes_verify_proof(&root, pos, proof->hash_sigs, &modhash))
 		return -ENOKEY;
 
 	return 0;
