@@ -1760,6 +1756,23 @@ modules: modules_prepare
 modules_prepare: prepare
 	$(Q)$(MAKE) $(build)=scripts scripts/module.lds
 
+ifdef CONFIG_MODULE_HASHES
+PHONY += module-hashes
+module-hashes: vmlinux scripts
+	$(Q)test -n "$(MODULE_HASH_LIST)" || { \
+		echo >&2 'MODULE_HASH_LIST must name an ordered module manifest'; \
+		false; \
+	}
+	$(Q)$(objtree)/scripts/modules-merkle-tree "$(MODULE_HASH_LIST)" \
+		$(objtree)/.tmp_module_hashes.bin
+	$(Q)$(OBJCOPY) --update-section \
+		.module_hashes=$(objtree)/.tmp_module_hashes.bin \
+		$(objtree)/vmlinux.unstripped
+	$(Q)$(OBJCOPY) --update-section \
+		.module_hashes=$(objtree)/.tmp_module_hashes.bin \
+		$(objtree)/vmlinux
+endif
+
 endif # CONFIG_MODULES
 
